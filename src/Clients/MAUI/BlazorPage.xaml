<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mauiPages="clr-namespace:K7.Clients.MAUI.Pages;assembly=K7.Clients.MAUI"
             x:Class="K7.Clients.MAUI.BlazorPage"
             BackgroundColor="#0d0907"
             Padding="0">

    <!-- MediaElement / SKLottieView are created in code when needed. Inflating them here
         costs multi-second cold start on Android TV (Release). -->
    <Grid x:Name="RootGrid" SafeAreaEdges="None">
        <!-- Blazor shell: on Android/iOS with native overlay, WebView is hidden during play.
             Windows Video.js + Blazor controls stay in WebView2 for the whole session. -->
        <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill"
                   BackgroundColor="Transparent"
                   ZIndex="2">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type mauiPages:MauiRoutes}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>

        <!-- Covers WebView until Blazor paints. Android DecorView Skottie owns branding when shown. -->
        <Grid x:Name="SplashOverlay" ZIndex="3"
              BackgroundColor="#0d0907"
              HorizontalOptions="Fill"
              VerticalOptions="Fill"
              InputTransparent="False">
            <Image x:Name="SplashLogo"
                   Source="k7_logo.png"
                   Aspect="AspectFit"
                   WidthRequest="220"
                   HeightRequest="120"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   InputTransparent="True"
                   ZIndex="0" />
        </Grid>

        <!-- Fallback close for native-only paths (Android/iOS); hidden on Windows (Blazor overlay handles close) -->
        <Button x:Name="NativePlayerCloseButton"
                Text="&#x2715;"
                IsVisible="False"
                ZIndex="4"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="16"
                WidthRequest="40"
                HeightRequest="40"
                CornerRadius="20"
                BackgroundColor="#80000000"
                TextColor="White"
                FontSize="18"
                Clicked="OnNativePlayerCloseClicked" />
    </Grid>
</ContentPage>
