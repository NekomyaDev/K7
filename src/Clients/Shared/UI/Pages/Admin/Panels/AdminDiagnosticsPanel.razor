@page "/admin/diagnostics"
@layout AdminLayout
@using K7.Server.Domain.Enums
@using K7.Shared.Diagnostics
@using K7.Shared.Dtos.Diagnostics
@implements IDisposable
@inject IStringLocalizer<AdminDiagnosticsPanel> L
@inject IStringLocalizer<SharedResource> S

<div class="diagnostics-dashboard">
    <AdminPageHeader Title="@L["DashboardTitle"]" Subtitle="@L["DashboardSubtitle"]">
        <Actions>
            <K7IconButton Icon="@Phosphor.Question" Size="sm" OnClick="OpenHelpAsync" AriaLabel="@L["HelpAriaLabel"]" />
            <K7IconButton Icon="@Phosphor.ArrowClockwise" Size="sm" OnClick="LoadAsync" Disabled="_isLoading"
                          AriaLabel="@L["Refresh"]" />
            <K7Button Size="sm" Variant="filled" Color="primary" Href="@BuildDetailsHref()" StartIcon="@Phosphor.ListBullets">
                @L["ViewAllIssues"]
            </K7Button>
        </Actions>
    </AdminPageHeader>

    @if (_isLoading)
    {
        <K7ProgressBar Indeterminate="true" />
    }
    else if (_summaries is not null)
    {
        <section class="diagnostics-dashboard__section" aria-label="@L["FilterSeverity"]">
            <div class="diagnostics-dashboard__stat-grid">
                @foreach (var (severity, label, count) in GetSeverityStats())
                {
                    @if (count == 0)
                    {
                        <span class="diagnostics-dashboard__stat-link diagnostics-dashboard__stat-link--disabled"
                              aria-disabled="true">
                            <K7Paper Outlined="true" Class="diagnostics-dashboard__stat-card">
                                <span class="text-overline">@label</span>
                                <h3 class="diagnostics-dashboard__stat-value @StatValueClass(count, severity)">@count</h3>
                            </K7Paper>
                        </span>
                    }
                    else
                    {
                        <a href="@BuildDetailsHref(severity: severity)"
                           class="diagnostics-dashboard__stat-link focusable">
                            <K7Paper Outlined="true" Class="diagnostics-dashboard__stat-card">
                                <span class="text-overline">@label</span>
                                <h3 class="diagnostics-dashboard__stat-value @StatValueClass(count, severity)">@count</h3>
                            </K7Paper>
                        </a>
                    }
                }
            </div>
            @if (_totalIssueCount > 0)
            {
                <p class="text-caption diagnostics-dashboard__stat-hint">@L["SeverityTotalsHint"]</p>
            }
        </section>

        @if (_totalIssueCount == 0)
        {
            <div class="diagnostics-dashboard__all-clear" role="status">
                <K7Icon Icon="@Phosphor.Fill.CheckCircle" Color="success" IconSize="K7IconSize.Xl" />
                <h6 class="diagnostics-dashboard__all-clear-title">@L["AllClear"]</h6>
            </div>
        }
        else
        {

        @if (!_isTv)
        {
            @foreach (var workClass in Enum.GetValues<DiagnosticWorkClass>())
            {
                var issues = GetIssuesWithCount(workClass);
                if (issues.Count == 0)
                {
                    continue;
                }

                var workClassCount = GetWorkClassCount(workClass);
                <section class="diagnostics-dashboard__section" aria-label="@GetWorkClassLabel(workClass)">
                    <div class="diagnostics-dashboard__section-heading">
                        <h6 class="diagnostics-dashboard__section-title">@GetWorkClassLabel(workClass)</h6>
                        <a href="@BuildDetailsHref(workClass: workClass)"
                           class="diagnostics-dashboard__see-all focusable">
                            @string.Format(L["WorkClassSeeAll"], workClassCount)
                        </a>
                    </div>
                    <div class="diagnostics-dashboard__issue-grid">
                        @foreach (var (issue, count) in issues)
                        {
                            var canFix = DiagnosticIssueTaxonomy.SupportsBulkFix(issue);
                            <K7Paper Outlined="true" Class="diagnostics-dashboard__issue-card">
                                <a href="@BuildDetailsHref(issue: issue)"
                                   class="diagnostics-dashboard__issue-card-body focusable">
                                    <div class="diagnostics-dashboard__issue-card-main">
                                        <span class="text-sm diagnostics-dashboard__issue-label"
                                              style="@(GetIssueLabelStyle(issue))">
                                            @GetIssueLabel(issue)
                                        </span>
                                        <span class="diagnostics-dashboard__issue-count">@count</span>
                                    </div>
                                </a>
                                <div class="diagnostics-dashboard__issue-card-footer">
                                    <span class="text-caption diagnostics-dashboard__stat-caption">
                                        @GetIssueCardCaption(issue)
                                    </span>
                                    @if (canFix)
                                    {
                                        <button type="button"
                                                class="diagnostics-dashboard__issue-fix focusable"
                                                @onclick="@(() => QueueIssueFixAsync(issue, count))"
                                                disabled="@_isQueueingFix"
                                                aria-label="@string.Format(L["QueueAllFixes"], count)">
                                            <K7Icon Icon="@Phosphor.Wrench" IconSize="K7IconSize.Sm" />
                                            <span>@L["FixAll"]</span>
                                        </button>
                                    }
                                </div>
                            </K7Paper>
                        }
                    </div>
                </section>
            }
        }

        @if (_librariesWithIssues.Count > 0)
        {
            <section class="diagnostics-dashboard__section" aria-label="@L["PerLibraryTitle"]">
                <h6 class="diagnostics-dashboard__section-title">@L["PerLibraryTitle"]</h6>
                <K7Table TItem="LibraryHealthSummaryDto" Items="_librariesWithIssues" Dense="true" Hover="true"
                         Class="diagnostics-dashboard__library-table"
                         OnRowClick="OnLibraryRowClick">
                    <HeaderContent>
                        <th>@L["FilterLibrary"]</th>
                        <th class="diagnostics-dashboard__library-col-kpi">@L["SeverityErrors"]</th>
                        <th class="diagnostics-dashboard__library-col-kpi">@L["SeverityWarnings"]</th>
                        <th class="diagnostics-dashboard__library-col-kpi">@L["SeverityInfo"]</th>
                    </HeaderContent>
                    <RowTemplate Context="library">
                        @{
                            var libraryId = library.LibraryId;
                            var errors = LibraryHealthSummaryCounts.SumErrors([library]);
                            var warnings = LibraryHealthSummaryCounts.SumWarnings([library]);
                            var infos = LibraryHealthSummaryCounts.SumInfo([library]);
                            var libraryHref = BuildDetailsHref(libraryId: libraryId);
                        }
                        <td>
                            <a href="@libraryHref"
                               class="text-sm diagnostics-dashboard__library-title focusable"
                               @onclick:stopPropagation="true">
                                @library.LibraryTitle
                            </a>
                        </td>
                        @foreach (var (severity, count) in new (string, int)[]
                                  {
                                      ("error", errors),
                                      ("warning", warnings),
                                      ("info", infos)
                                  })
                        {
                            <td class="diagnostics-dashboard__library-col-kpi">
                                @if (count == 0)
                                {
                                    <span class="diagnostics-dashboard__library-kpi diagnostics-dashboard__library-kpi--disabled"
                                          aria-disabled="true">
                                        <span class="diagnostics-dashboard__library-kpi-value diagnostics-dashboard__library-kpi-value--ok">@count</span>
                                    </span>
                                }
                                else
                                {
                                    <a href="@BuildDetailsHref(severity: severity, libraryId: libraryId)"
                                       class="diagnostics-dashboard__library-kpi focusable"
                                       @onclick:stopPropagation="true">
                                        <span class="diagnostics-dashboard__library-kpi-value diagnostics-dashboard__library-kpi-value--@severity">@count</span>
                                    </a>
                                }
                            </td>
                        }
                    </RowTemplate>
                </K7Table>
            </section>
        }
        }
    }
</div>
